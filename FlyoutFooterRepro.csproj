<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FlyoutFooterRepro</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Version from the issue (dotnet/maui#39679). Change to test other versions. -->
    <MauiVersion>10.0.110</MauiVersion>

    <ApplicationTitle>FlyoutFooterRepro</ApplicationTitle>
    <ApplicationId>com.companyname.flyoutfooterrepro</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

	<ItemGroup>
		<!-- Prilagodi verzije po potrebi (issue omenja MAUI 10.0.110) -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
	</ItemGroup>
</Project>
